# All optional. Defaults work on Base Sepolia without any API key.
# NODE_RPC_URL=https://sepolia.base.org
# BUNDLER_RPC_URL=https://api.candide.dev/public/v3/84532
# PAYMASTER_RPC_URL=https://api.candide.dev/public/v3/84532
# SPONSORSHIP_POLICY_ID=            # Candide dashboard policy, if you use a private paymaster URL
# Published guardian keys (public addresses), built into the browser code. `npm run dev` sets them from the local services.
# NEXT_PUBLIC_SQ_GUARDIAN_KEY=0x...        # Swissquote guardian HSM
# NEXT_PUBLIC_PARTNER_GUARDIAN_KEY=0x...   # independent partner guardian
# NEXT_PUBLIC_PASSPORT_GUARDIAN_KEY=0x...  # passport guardian identity key (its /info "attestor")
# For the Swissquote guardian process only: the issuer keys it trusts.
# LIVENESS_VENDOR=0x...
# PASSPORT_ATTESTOR=0x...
# SQ_OPS_KEY=0x...                  # Owner key of the operations Safe (relayer, demo treasury, fee collector)
# NEXT_PUBLIC_STEP_UP_THRESHOLD=5000000   # 5 USDC, in 6-decimal units
# DATA_DIR=.data
