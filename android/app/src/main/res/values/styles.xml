<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Signer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#FA5B35</item>
    </style>
    <color name="bg">#F5F7FA</color>
    <color name="strong">#0E121B</color>
    <color name="sub">#525866</color>
    <color name="soft">#99A0AE</color>
    <style name="Label"><item name="android:textColor">@color/sub</item><item name="android:textSize">13sp</item></style>
    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textColor">@color/strong</item>
    </style>
</resources>
