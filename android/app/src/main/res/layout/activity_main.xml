<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Swissquote ID" android:textColor="#FA5B35" android:textSize="15sp" android:textStyle="bold" />

        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Sign with your DNI"
            android:textColor="@color/strong" android:textSize="26sp" />

        <TextView android:id="@+id/origin" style="@style/Label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" />

        <LinearLayout android:id="@+id/summaryCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="YOU ARE SIGNING" android:textSize="11sp" android:letterSpacing="0.08" />
            <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" android:textColor="@color/strong" android:textSize="15sp" />
            <TextView android:id="@+id/hash" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="@color/soft" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/form" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:orientation="vertical">
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CAN: the 6 digits at the bottom right of the front of your DNI" />
            <EditText android:id="@+id/can" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:inputType="number" android:maxLength="6" android:hint="123456" />
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="DNI PIN (the one you chose at the police station)" />
            <EditText android:id="@+id/pin" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:inputType="textPassword" android:maxLength="16" />
            <Button android:id="@+id/go" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="20dp" android:background="@drawable/bg_button" android:stateListAnimator="@null"
                android:text="Read my DNI" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
        </LinearLayout>

        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center" android:lineSpacingExtra="4dp"
            android:textColor="@color/sub" android:textSize="15sp" />

        <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center" android:textSize="12sp"
            android:text="Your PIN goes only to the card. The card signs; this app never sees your private key." />
    </LinearLayout>
</ScrollView>
